# ==============================================================================
# TELEGRAM ENTERPRISE PRODUCTION CONFIGURATION (.env.production)
# Target Scale: 50 - 100 Employees / 3,000+ Concurrent Client Chats
# ==============================================================================

# 1. Django Core Security
DEBUG=False
DJANGO_SECRET_KEY=generate_a_random_64_char_secret_key_here
ALLOWED_HOSTS=*

# 2. Database Configuration (PostgreSQL recommended for 50-100 staff)
POSTGRES_DB=tbotchat
POSTGRES_USER=tbot
POSTGRES_PASSWORD=replace_with_strong_database_password
# Or full DATABASE_URL:
# DATABASE_URL=postgresql://tbot:password@postgres:5432/tbotchat

# 3. Redis High-Throughput WebSocket Cluster
REDIS_URL=redis://redis:6379/0

# 4. Telegram Bot API Credentials
# Replace with the primary Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz
# Secret token for verifying incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=your_custom_webhook_secret_string

# 5. Network & Domain
# Public URL for the reverse proxy or domain (e.g. https://chat.company.com)
PUBLIC_DOMAIN=https://chat.company.com
CORS_ALLOW_ALL_ORIGINS=True
