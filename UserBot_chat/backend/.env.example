# .env.example - Copy to backend/.env and replace placeholder tokens

DJANGO_SECRET_KEY=change-in-production-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
TELEGRAM_WEBHOOK_SECRET=your-secure-webhook-secret-token

# Centralized fallback token
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Bot 1: ah fu
BOT1_NAME=ah fu
BOT1_USER_ID=ahfu
BOT1_PASSWORD=ahfu1234
BOT1_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Bot 2: Bingo
BOT2_NAME=Bingo
BOT2_USER_ID=bingo
BOT2_PASSWORD=bingo1234
BOT2_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789

# Bot 3: mrlioma
BOT3_NAME=mrlioma
BOT3_USER_ID=mrlioma
BOT3_PASSWORD=mrlioma1234
BOT3_TOKEN=1234567890:ABCdefGHIjklMNOpqrsTUVwxyz123456789
